APP_NAME="POS System"
APP_ENV=local
APP_KEY=base64:vkUS/iNn5OM0e/0FiuRaZuOs5JOTLvQ5w+SzwB9gKQs=
APP_DEBUG=true
APP_URL=http://localhost/point-of-sales/public

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
